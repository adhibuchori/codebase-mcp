# Copy this file to ".env" and fill it in.

# Secret key (min. 24 characters). Generate one with: bun run gen-key
MCP_API_KEY=

# Repos that may be read: name=path, separated by semicolons (;)
# Mac:
REPOS=core-api=/Users/yourname/work/core-api;web=/Users/yourname/work/web-app
# Windows (use forward slashes / to be safe):
# REPOS=core-api=C:/Users/yourname/work/core-api;web=D:/work/web-app

# Local port (no need to change)
PORT=8787

# --- Tunnel settings (used by `bun tunnel`) ---
# Provider: cloudflared on Mac/Linux, pinggy on Windows by default. Uncomment to override.
# TUNNEL=cloudflared

# Mac (Cloudflare): token of a named tunnel from the Cloudflare Zero Trust dashboard.
# Leave empty to use a temporary quick tunnel (random URL, testing only).
CF_TUNNEL_TOKEN=

# Windows (Pinggy): optional Pinggy Pro access token for a fixed URL.
# Leave empty to use a free tunnel (random URL).
PINGGY_TOKEN=

# --- Checking the public URL (used by `bun run check`; the server itself doesn't read these) ---
# Public URL of your tunnel, without /mcp, e.g. https://work-codebase-mcp.yourdomain.com
PUBLIC_URL=
# Cloudflare Access service token (Access → Service Auth → Service Tokens).
# ClickUp needs the same values as custom headers CF-Access-Client-Id and CF-Access-Client-Secret.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: extra regex patterns for files that must NOT be read, comma-separated
# EXTRA_BLOCKED=^config-prod\.json$,\.sql$
