# Copy this file to ".env" (or run: bun run setup, which creates it for you).
# .env holds secrets only. Which repos are served lives in codebase.config.json.

# Secret key (min. 24 characters). bun run setup creates one; bun run gen-key prints a new one.
MCP_API_KEY=

# Local port and address (no need to change; the tunnel is the only way in).
PORT=8787
# HOST=127.0.0.1

# Optional: another config file than ./codebase.config.json
# CODEBASE_CONFIG=/path/to/codebase.config.json

# Legacy (v1): repos as name=path pairs, separated by semicolons. Used only when there is no
# codebase.config.json. Prefer bun run setup, which finds every repo under a folder for you.
# REPOS=core-api=/Users/yourname/work/core-api;web=C:/work/web-app

# Optional: extra regex patterns for file names that must NOT be read, comma-separated.
# (codebase.config.json has a "blocked" list for the same purpose.)
# EXTRA_BLOCKED=^config-prod\.json$,\.sql$

# Optional: search engine. ripgrep ships with the npm install; set RG_PATH to use another binary,
# or CODEBASE_NO_RIPGREP=1 to force the JavaScript scanner (for machines that block binaries).
# RG_PATH=
# CODEBASE_NO_RIPGREP=1

# Optional: debug | info | warn | error. debug adds one "search plan" line per search and the reason
# for every index run; README → "Reading the logs" explains them.
# LOG_LEVEL=info

# --- Tunnel settings (used by `bun tunnel`) ---
# Provider: cloudflared on Mac/Linux, pinggy on Windows by default. Uncomment to override.
# TUNNEL=cloudflared

# Mac (Cloudflare): token of a named tunnel from the Cloudflare Zero Trust dashboard.
# Leave empty to use a temporary quick tunnel (random URL, testing only).
CF_TUNNEL_TOKEN=

# Windows (Pinggy): optional Pinggy Pro access token for a fixed URL.
# Leave empty to use a free tunnel (random URL).
PINGGY_TOKEN=

# --- Checking the public URL (used by `bun run check`; the server itself doesn't read these) ---
# Public URL of your tunnel, without /mcp, e.g. https://work-codebase-mcp.yourdomain.com
PUBLIC_URL=
# Cloudflare Access service token (Access → Service Auth → Service Tokens).
# ClickUp needs the same values as custom headers CF-Access-Client-Id and CF-Access-Client-Secret.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
