{
  "name": "codebase-mcp",
  "version": "2.1.0",
  "private": true,
  "description": "Read-only MCP server that lets AI assistants search and read many local repos — fast, token-efficient, built for debugging microservices (Mac and Windows).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts start",
    "stdio": "bun src/index.ts stdio",
    "index": "bun src/index.ts index",
    "tunnel": "bun scripts/tunnel/tunnel.ts",
    "check": "bun scripts/remote/remote-check.ts",
    "setup": "bun scripts/setup/setup.ts",
    "doctor": "bun scripts/doctor/doctor.ts",
    "gen-key": "bun scripts/keys/gen-key.ts",
    "eval": "bun scripts/eval/run-eval.ts",
    "bench": "bun scripts/bench/scale.ts",
    "grammars:sync": "bun scripts/grammars/sync.ts",
    "config:schema": "bun scripts/config/write-schema.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage && node scripts/check/coverage-files.mjs",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src scripts .claude/hooks",
    "format": "oxfmt src scripts .claude/hooks",
    "format:check": "oxfmt --check src scripts .claude/hooks",
    "fl": "bun run format && bun run lint",
    "fl:ci": "bun run format:check && oxlint --type-aware --deny-warnings src scripts .claude/hooks",
    "check:comments": "node scripts/check/comment-style.mjs",
    "check:dead-code": "knip-bun",
    "check:folder-shape": "node scripts/check/folder-shape.mjs",
    "check:coverage-policy": "node scripts/check/coverage-policy.mjs",
    "check:mocks": "bun scripts/check/module-mocks.ts",
    "check:version": "bun scripts/check/version-sync.ts",
    "gates": "bash scripts/check/gates.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vscode/ripgrep": "1.18.0",
    "hono": "4.13.13",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=22.18.0"
  }
}
